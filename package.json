{
  "name": "jarvis",
  "version": "0.6.0",
  "private": true,
  "description": "Your own team of AI experts on your desktop, running on your Claude plan through Claude Code.",
  "homepage": "https://github.com/msja1729/Jarvis",
  "repository": {
    "type": "git",
    "url": "https://github.com/msja1729/Jarvis.git"
  },
  "bugs": {
    "url": "https://github.com/msja1729/Jarvis/issues"
  },
  "main": "dist/app/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "measure": "esbuild scripts/measure-baseline.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/measure.mjs && node dist/measure.mjs",
    "docs:pdf": "node scripts/docs-pdf.mjs"
  },
  "build": {
    "appId": "dev.jarvis.desktop",
    "productName": "Jarvis",
    "asar": false,
    "npmRebuild": false,
    "files": [
      "dist/**",
      "docs/connect-*.md",
      "package.json",
      "!dist/**/*.map",
      "!**/node_modules/**/{test,tests,__tests__,example,examples}/**",
      "!**/node_modules/**/*.{md,map,ts,tsx}",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v3/linux/**",
      "!**/node_modules/@napi-rs/canvas*/**",
      "!**/node_modules/@huggingface/transformers/.cache/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "dist/**",
        "docs/connect-*.md",
        "package.json",
        "!dist/**/*.map",
        "!**/node_modules/**/{test,tests,__tests__,example,examples}/**",
        "!**/node_modules/**/*.{md,map,ts,tsx}",
        "!**/node_modules/onnxruntime-web/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/linux/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/darwin/**",
        "!**/node_modules/@napi-rs/canvas*/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**",
        "!**/node_modules/@huggingface/transformers/.cache/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Jarvis",
      "deleteAppDataOnUninstall": true,
      "artifactName": "Jarvis-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "uninstallDisplayName": "Jarvis",
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "minimumSystemVersion": "13.0",
      "category": "public.app-category.productivity",
      "files": [
        "dist/**",
        "docs/connect-*.md",
        "package.json",
        "!dist/**/*.map",
        "!**/node_modules/**/{test,tests,__tests__,example,examples}/**",
        "!**/node_modules/**/*.{md,map,ts,tsx}",
        "!**/node_modules/onnxruntime-web/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/linux/**",
        "!**/node_modules/onnxruntime-node/bin/napi-v3/win32/**",
        "!**/node_modules/@napi-rs/canvas*/**",
        "!**/node_modules/@huggingface/transformers/.cache/**"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Jarvis listens when you press the push-to-talk shortcut, and records meetings when you ask it to.",
        "NSAudioCaptureUsageDescription": "Jarvis records meeting audio when you ask it to."
      }
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "kokoro-js": "^1.2.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.19.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fflate": "0.8.3",
    "highlight.js": "11.12.0",
    "katex": "0.19.0",
    "mermaid": "12.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10",
    "zod": "4.6.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "type": "module",
  "overrides": {
    "mermaid": {
      "katex": "$katex"
    },
    "sharp": "0.35.5"
  }
}
